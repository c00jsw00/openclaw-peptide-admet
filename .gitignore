# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter Notebook
.ipynb_checkpoints

# PyTorch models — ignored by default; the v4 endpoint weights are small
# (~6 MB total across 4 models) and ARE committed so the models are usable
# straight from the repo without retraining.
*.pth
!models_v4/
!models_v4/**
!models_v4/**/*.pt
!models_v4/**/*.pth

# Numpy data (large files) — the v4.1 frozen ESMC-600M embedding caches ARE
# committed so training/prediction of the sequence endpoints works without the
# Python >= 3.12 ESMC env.
*.npy
*.npz
!data/esmc/
!data/esmc/**/*.npz
# v4.2 frozen MoLFormer-XL embedding caches ARE committed so training/
# prediction of the molecular endpoints works without transformers at runtime.
!data/molformer/
!data/molformer/**/*.npz

# Pandas data (large files) — the prepared PepADMET endpoint CSVs ARE the
# committed training data (deterministic prepared inputs, ~3.4 MB total).
*.csv
!data/pepadmet_*.csv
*.feather
*.parquet
# PeptiVerse raw-data parquets ARE committed (~10 MB): deterministic
# training input for analysis/peptiverse_experiment.py (source: HuggingFace
# ChatterjeeLab/PeptiVerse_data, permeability_pampa / permeability_caco2,
# ChemBERTa-77M-MLM embeddings precomputed by the authors).
!data/peptiverse/
!data/peptiverse/**/*.parquet

# Model checkpoints
checkpoints/
model_checkpoints/

# Training logs
logs/
tensorboard/
# v4 run log committed as the human-readable record of the training run
!train_v4.log
# v4.1 (ESMC) run log
!train_v41.log
# v4.2 (ESMC + MoLFormer) run log
!train_v42.log

# Scratch / local-only experiment files (R² probes, E2E verify, ad-hoc logs)
_[a-z]*.py
_[a-z]*.log

# 176MB feature cache rebuilt by analysis/ scripts (RDKit 217 + Morgan r2
# + MoLFormer 768, ~8 min to rebuild on CPU). NOT committed: it duplicates
# data already in data/ (CSV + molformer npz) and would bloat the repo.
_pampa_feat_cache.npz
# Caco-2 feature cache rebuilt by analysis/chemberta_retrain.py caco2
# (RDKit 217 + Morgan r2, ~10 min to rebuild on CPU). NOT committed.
_caco2_feat_cache.npz
# ChemBERTa embeddings: negative-result experiment only (route 6, not in the
# v4.2 pipeline). Rebuild with `chemberta_embed.py` (~30 min, needs
# transformers + HF download of deepchem/ChemBERTa-77M-MLM) — see
# analysis/README.md. The measured results are committed as
# analysis/chemberta_results{,_caco2}.json.
data/chemberta/

# GitHub
.github/

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
