# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.idea/
.vscode/
*.swp
*.swo

# Jupyter Notebook
.ipynb_checkpoints

# PyTorch models — ignored by default; the v4 endpoint weights are small
# (~6 MB total across 4 models) and ARE committed so the models are usable
# straight from the repo without retraining.
*.pth
!models_v4/
!models_v4/**
!models_v4/**/*.pt
!models_v4/**/*.pth

# Numpy data (large files)
*.npy
*.npz

# Pandas data (large files) — the prepared PepADMET endpoint CSVs ARE the
# committed training data (deterministic prepared inputs, ~3.4 MB total).
*.csv
!data/pepadmet_*.csv
*.feather
*.parquet

# Model checkpoints
checkpoints/
model_checkpoints/

# Training logs
logs/
tensorboard/
# v4 run log committed as the human-readable record of the training run
!train_v4.log

# GitHub
.github/

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
